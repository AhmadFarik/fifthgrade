                            <tr>
                                <th>مئات</th><th>عشرات</th><th>آحاد</th>
                                <th>مئات</th><th>عشرات</th><th>آحاد</th>
                                <th>مئات</th><th>عشرات</th><th>آحاد</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td><input type="text" placeholder="-" disabled></td>
                                <td><input type="text" placeholder="-" disabled></td>
                                <td><input type="text"></td>
                                <td><input type="text"></td>
                                <td><input type="text"></td>
