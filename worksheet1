<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>دوسية الرياضيات التفاعلية - الصف الخامس الأساسي</title>
    <link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;500;700;800;900&display=swap" rel="stylesheet">
    <style>
        :root {
            --primary-blue: #1e88e5;
            --primary-dark-blue: #1565c0;
            --secondary-purple: #8e24aa;
            --accent-orange: #fb8c00;
            --accent-green: #43a047;
            --accent-red: #e53935;
            --bg-light: #eceff1;
            --card-bg: #ffffff;
            --text-dark: #2c3e50;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Tajawal', sans-serif;
        }

        body {
            background-color: var(--bg-light);
            color: var(--text-dark);
            padding: 20px 0;
            -webkit-print-color-adjust: exact;
            print-color-adjust: exact;
        }

        /* A4 Page Dimensions & Setup */
        .page {
            width: 210mm;
            min-height: 297mm;
            padding: 15mm;
            margin: 0 auto 25px auto;
            background: var(--card-bg);
            box-shadow: 0 10px 25px rgba(0,0,0,0.1);
            position: relative;
            border-radius: 4px;
            page-break-after: always;
            page-break-inside: avoid;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }

        /* Ribbon Banner Header */
        .ribbon-header {
            position: relative;
            background: linear-gradient(135deg, var(--primary-blue), var(--secondary-purple));
            color: white;
            padding: 12px 20px;
            border-radius: 10px;
            box-shadow: 0 4px 10px rgba(0,0,0,0.15);
            margin-bottom: 15px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .ribbon-header::before, .ribbon-header::after {
            content: '';
            position: absolute;
            bottom: -8px;
            border-top: 8px solid #0d47a1;
            border-left: 8px solid transparent;
            border-right: 8px solid transparent;
        }
        .ribbon-header::before { right: 15px; }
        .ribbon-header::after { left: 15px; }

        .logo-badge-container {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .school-logo {
            width: 45px;
            height: 45px;
            background: white;
            color: var(--primary-blue);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 900;
            font-size: 20px;
            box-shadow: 0 2px 5px rgba(0,0,0,0.2);
        }

        .header-titles h1 {
            font-size: 20px;
            font-weight: 900;
            margin-bottom: 2px;
        }

        .header-titles h2 {
            font-size: 13px;
            font-weight: 500;
            opacity: 0.9;
        }

        .badge-rating {
            background: rgba(255, 255, 255, 0.25);
            padding: 6px 12px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: 700;
            border: 1px solid rgba(255, 255, 255, 0.4);
            backdrop-filter: blur(4px);
            text-align: center;
        }

        /* Student Information Bar */
        .student-info-bar {
            display: flex;
            justify-content: space-between;
            background: #f1f8e9;
            border: 1.5px solid var(--accent-green);
            padding: 8px 15px;
            border-radius: 8px;
            margin-bottom: 12px;
            font-size: 13px;
            font-weight: 700;
            color: #2e7d32;
        }

        /* Objectives Card */
        .objectives-card {
            background: #fff8e1;
            border: 1.5px solid var(--accent-orange);
            border-radius: 8px;
            padding: 10px 15px;
            margin-bottom: 12px;
        }

        .objectives-card h3 {
            color: #e65100;
            font-size: 14px;
            margin-bottom: 5px;
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .objectives-list {
            display: flex;
            gap: 15px;
            list-style: none;
            font-size: 12px;
            font-weight: 600;
            color: #424242;
        }

        .objectives-list li::before {
            content: "🎯 ";
        }

        /* Activity Cards Styling */
        .activity-card {
            background: #ffffff;
            border-radius: 8px;
            border: 1px solid #cfd8dc;
            box-shadow: 0 2px 5px rgba(0,0,0,0.03);
            margin-bottom: 12px;
            overflow: hidden;
        }

        .activity-header {
            padding: 6px 12px;
            color: white;
            font-weight: 800;
            font-size: 13px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .act-1 { background: linear-gradient(90deg, var(--primary-blue), #42a5f5); }
        .act-2 { background: linear-gradient(90deg, var(--secondary-purple), #ab47bc); }
        .act-3 { background: linear-gradient(90deg, var(--accent-orange), #ffa726); }
        .act-4 { background: linear-gradient(90deg, var(--accent-green), #66bb6a); }
        .act-5 { background: linear-gradient(90deg, var(--accent-red), #ef5350); }

        .activity-body {
            padding: 10px 12px;
            font-size: 12.5px;
            line-height: 1.5;
        }

        /* Place Value Table */
        .pv-table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 6px;
            text-align: center;
            font-size: 11.5px;
        }

        .pv-table th, .pv-table td {
            border: 1px solid #b0bec5;
            padding: 5px;
        }

        .pv-table th {
            font-weight: 700;
        }

        .pv-table th.th-millions { background-color: #bbdefb; color: #0d47a1; }
        .pv-table th.th-thousands { background-color: #e1bee7; color: #4a148c; }
        .pv-table th.th-ones { background-color: #ffe0b2; color: #e65100; }

        input[type="text"] {
            width: 95%;
            padding: 3px;
            border: 1px solid #b0bec5;
            border-radius: 4px;
            text-align: center;
            font-family: 'Tajawal', sans-serif;
            font-size: 12px;
            background-color: #fafafa;
        }

        .blank-line {
            display: inline-block;
            border-bottom: 1.5px dashed #78909c;
            min-width: 120px;
            height: 18px;
            vertical-align: middle;
            margin: 0 4px;
        }

        /* Answer Key Specific Styling */
        .answer-key-header {
            background: linear-gradient(135deg, var(--accent-green), #00695c) !important;
        }

        .answer-text {
            color: #1b5e20;
            font-weight: 800;
            background-color: #e8f5e9;
            padding: 2px 6px;
            border-radius: 4px;
            border: 1px dotted #4caf50;
        }

        /* Footer */
        .page-footer {
            text-align: center;
            font-size: 10.5px;
            color: #78909c;
            border-top: 1px solid #cfd8dc;
            padding-top: 8px;
            margin-top: auto;
            display: flex;
            justify-content: space-between;
        }

        /* Floating Action Print Button */
        .print-btn {
            position: fixed;
            bottom: 20px;
            left: 20px;
            background: linear-gradient(135deg, #1e88e5, #1565c0);
            color: white;
            padding: 12px 22px;
            border: none;
            border-radius: 30px;
            font-size: 14px;
            font-weight: 800;
            cursor: pointer;
            box-shadow: 0 6px 16px rgba(0,0,0,0.25);
            z-index: 1000;
            display: flex;
            align-items: center;
            gap: 8px;
            transition: all 0.3s ease;
        }

        .print-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(0,0,0,0.3);
        }

        /* Print Media Styles */
        @media print {
            body {
                background: none;
                padding: 0;
            }
            .page {
                box-shadow: none;
                margin: 0;
                width: 100%;
                height: 100%;
                border-radius: 0;
                padding: 10mm;
            }
            .no-print {
                display: none !important;
            }
            input[type="text"] {
                border: 1px solid #90a4ae;
                background-color: transparent;
            }
        }
    </style>
</head>
<body>

    <button class="print-btn no-print" onclick="window.print()">
