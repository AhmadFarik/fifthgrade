            </div>

            <!-- Student Info Bar -->
            <div class="student-info-bar">
                <span>اسم الطالب/ة: .....................................................</span>
                <span>الشعبة: ( ..... )</span>
                <span>التاريخ: ..... / ..... / 2026م</span>
            </div>

            <!-- Objectives -->
            <div class="objectives-card">
                <h3>🎯 أهداف الدرس المعيارية:</h3>
